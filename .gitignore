venv/
__pycache__/
dados_brutos
.DS_Store
.env

# scriptLattes vendorizado: binário, cache de CVs baixados e saídas de scraping
# não são versionados
scriptlattes/chromedriver
scriptlattes/cache/
scriptlattes/exemplo/alunos_pesc/
scriptlattes/exemplo/professores_ufrj/

# Bases de comparação: as .list enviadas ficam versionadas, mas o .config
# (regenerado a cada extração) e a saída bruta do scriptLattes, não.
scriptlattes/exemplo/comparacao/*.config
scriptlattes/exemplo/comparacao/*_saida/

# Core dumps: quando o Streamlit morre, o kernel despeja a memória do processo
# na raiz do projeto (arquivos de GB). São lixo de crash, nunca versionar --
# um deles chegou a entrar num commit e travou o push (limite de 100 MB do GitHub).
core.*

# Backups automáticos da base gerados antes de reprocessar: ficam no disco para
# eventual restauração, mas não no histórico.
*.duckdb.bak*