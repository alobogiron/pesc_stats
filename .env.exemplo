# Modelo do .env (copie para `.env` e preencha). Nenhuma destas chaves é
# obrigatória para o app subir: sem elas o notebook degrada graciosamente --
# as seções de ORCID/Scopus rodam com 0 resultados, sem falhar.
#
# O .env é lido em runtime (env_file do docker-compose) e nunca entra na
# imagem: está no .dockerignore, junto com o .gitignore.

# ORCID -- credenciais da API pública (https://orcid.org/developer-tools)
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Scopus/Elsevier (https://dev.elsevier.com)
SCOPUS_API_KEY=
# Opcional: só se a instituição usar token institucional
SCOPUS_INST_TOKEN=
