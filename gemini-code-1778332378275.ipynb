import json
import pandas as pd
import glob
import numpy as np

# 1. CARREGAMENTO DOS DADOS (Simulando a leitura dos arquivos)
caminhos_arquivos = glob.glob('dados_brutos/*.json')

lista_pessoas = []
lista_formacao = []

for arquivo in caminhos_arquivos:
    with open(arquivo, 'r', encoding='utf-8') as f:
        dados = json.load(f)
        id_lattes = dados['informacoes_pessoais']['id_lattes']
        
        # Pessoas
        df_pessoa = pd.json_normalize(dados['informacoes_pessoais'])
        lista_pessoas.append(df_pessoa)
        
        # Formação (usaremos como exemplo para analisar listas)
        if 'formacao_academica' in dados and dados['formacao_academica']:
            df_form = pd.DataFrame(dados['formacao_academica'])
            df_form['id_lattes'] = id_lattes
            lista_formacao.append(df_form)

df_pessoas = pd.concat(lista_pessoas, ignore_index=True)
df_formacao = pd.concat(lista_formacao, ignore_index=True)

# ---------------------------------------------------------
# 2. ANÁLISE E DIAGNÓSTICO DOS DADOS
# ---------------------------------------------------------

print("=== VISÃO GERAL: TABELA PESSOAS ===")
# .info() mostra o tipo de dado de cada coluna e a quantidade de dados não nulos
display(df_pessoas.info()) 

print("\n=== AMOSTRA DOS DADOS ===")
display(df_pessoas.head())

# ---------------------------------------------------------
# 3. CAÇANDO VALORES AUSENTES (NULOS E VAZIOS)
# ---------------------------------------------------------
print("\n=== CONTAGEM DE VALORES NULOS REAIS (NaN) ===")
display(df_pessoas.isnull().sum())

# CUIDADO: No Lattes, muitas vezes o dado não vem como nulo (NaN), 
# mas sim como uma string vazia "". Vamos procurar por elas:
print("\n=== CONTAGEM DE STRINGS VAZIAS ('') ===")
strings_vazias = (df_pessoas == "").sum()
display(strings_vazias[strings_vazias > 0])

# ---------------------------------------------------------
# 4. ANALISANDO INCONSISTÊNCIAS E TIPOS DE DADOS
# ---------------------------------------------------------
print("\n=== ANÁLISE DE DATAS ===")
# O campo 'atualizacao_cv' costuma vir como string (ex: '15/10/2025').
# Tentar converter para datetime revela erros ocultos.
try:
    datas_convertidas = pd.to_datetime(df_pessoas['atualizacao_cv'], format='%d/%m/%Y')
    print("Sucesso: Todas as datas de atualização estão no formato correto.")
except Exception as e:
    print(f"ALERTA: Encontrado problema nas datas: {e}")

print("\n=== ANÁLISE DE CATEGORIAS (TABELA FORMAÇÃO) ===")
# .value_counts() é perfeito para ver se há categorias duplicadas por erro de digitação
# Ex: "Mestrado" vs "mestrado" vs "Mestrado em Computação"
print("Tipos de formação encontrados:")
display(df_formacao['tipo'].value_counts())

print("\n=== ANÁLISE DE CAMPOS NUMÉRICOS (ANOS) ===")
# Na formação ou atuação, o ano muitas vezes vem como "Atual" em vez de um número.
# Isso impede contas matemáticas. Vamos checar os valores únicos da coluna 'ano_conclusao':
print("Valores presentes na coluna ano_conclusao:")
display(df_formacao['ano_conclusao'].unique())